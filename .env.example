# ==============================================================================
# Supriya Travels — Environment Configuration for Vercel / Production Deployment
# ==============================================================================

# 0. Contact Form Submissions (Formspree)
# Endpoint from your Formspree dashboard: https://formspree.io/forms
# Exposed to the browser (VITE_ prefix) — the form ID is a public endpoint, not a secret.
VITE_FORMSPREE_ENDPOINT=https://formspree.io/f/mnpqzobv

# 1. Contact Form Email Notifications (Recommended: Resend)
# Get your API key from https://resend.com
RESEND_API_KEY=re_your_api_key_here

# The recipient email address for enquiry lead notifications (Default: supriyatravelsindia@gmail.com)
CONTACT_NOTIFICATION_EMAIL=supriyatravelsindia@gmail.com

# 2. Optional: Webhook URL for CRM / Discord / Slack / Zapier / Make
# CONTACT_WEBHOOK_URL=https://discord.com/api/webhooks/...

# 3. Optional: Nitro Deployment Preset (Auto-detected on Vercel)
# NITRO_PRESET=vercel
